# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Google Gemini -------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs for the two general-purpose arms. Leave blank until verified
# against the live model list (see README: `python -m benchmark.adapters.list_models`).
# Nothing in the code hard-codes a model ID; both arms read these.
SMALL_MODEL=
LARGE_MODEL=

# Which provider backend the LLM adapters use: gemini_native | openai_compat
LLM_PROVIDER=gemini_native

# Optional: route through an OpenAI-compatible gateway instead (OpenRouter etc.)
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=

# Primary benchmark determinism settings (see DESIGN.md §19)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
